{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "baseUrl": ".", "paths": {"frameforge": ["src/core/index.tsx"], "@/*": ["src/*"]},
    "types": ["node"]
  },
  "include": ["src", "examples", "tests", "vite.config.ts"]
}
