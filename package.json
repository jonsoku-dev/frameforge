{
  "name": "frameforge-local",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonsoku-dev/frameforge.git"
  },
  "bugs": {
    "url": "https://github.com/jonsoku-dev/frameforge/issues"
  },
  "homepage": "https://github.com/jonsoku-dev/frameforge#readme",
  "private": true,
  "type": "module",
  "bin": {
    "frameforge": "bin/frameforge.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.tsx",
    "render": "node scripts/render.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "score": "python3 scripts/assets/score.py",
    "frame-check": "node scripts/frame-check.mjs",
    "lint:video": "node scripts/lint.mjs",
    "skill:install": "node scripts/skill-install.mjs",
    "skill:uninstall": "node scripts/skill-uninstall.mjs",
    "art": "python3 scripts/assets/art.py",
    "voice": "python3 scripts/assets/voice.py",
    "blender": "python3 scripts/assets/blender.py",
    "models": "python3 scripts/assets/models.py",
    "beats": "python3 scripts/assets/beats.py",
    "seam-check": "node scripts/seam-check.mjs",
    "narration-check": "node scripts/narration-check.mjs",
    "geo": "python3 scripts/assets/geo.py",
    "transcribe": "node scripts/transcribe.mjs"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "katex": "^0.16.22",
    "lottie-web": "^5.13.0",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
